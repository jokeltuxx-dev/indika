//@version=6
indicator("All-in-One Institutional Market Scanner", shorttitle="SMC Scanner", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500, max_bars_back=5000)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░░░░░░ MODULE TOGGLES ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

grp_modules = "═══ MODULE TOGGLES ═══"
show_diagonal      = input.bool(true,  "① Diagonal Trend Lines",        group=grp_modules, inline="m1")
show_confluence    = input.bool(true,  "② Confluence Engine",            group=grp_modules, inline="m2")
show_sd_zones      = input.bool(true,  "③ Supply / Demand Zones",       group=grp_modules, inline="m3")
show_structure     = input.bool(true,  "④ Market Structure (BOS/CHoCH)", group=grp_modules, inline="m4")
show_orderblocks   = input.bool(true,  "⑤ Order Blocks",                group=grp_modules, inline="m5")
show_liquidity     = input.bool(true,  "⑥ Liquidity & Sweeps",          group=grp_modules, inline="m6")
show_fvg           = input.bool(true,  "⑦ FVG / Imbalances",            group=grp_modules, inline="m7")
show_ote           = input.bool(true,  "⑦ OTE Zones (Fibonacci)",       group=grp_modules, inline="m7b")
show_sweep_rev     = input.bool(true,  "⑧ Sweep + Reversal Trigger",    group=grp_modules, inline="m8")
show_premium_disc  = input.bool(true,  "⑨ Premium / Discount Zones",    group=grp_modules, inline="m9")
show_market_phase  = input.bool(true,  "⑩ Market Phase Detector",       group=grp_modules, inline="m10")
show_volume_climax = input.bool(true,  "⑪ Volume Climax & Exhaustion",  group=grp_modules, inline="m11")

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░░░░░░ SETTINGS GROUPS ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// --- Swing Detection ---
grp_swing = "═══ SWING DETECTION ═══"
swing_length   = input.int(5,  "Pivot Length",         minval=2, maxval=50, group=grp_swing, inline="sw1")

// --- Structure ---
grp_struct = "═══ ④ STRUCTURE (BOS / CHoCH) ═══"
struct_label_size = input.string("small", "Label Size", options=["tiny","small","normal","large"], group=grp_struct, inline="st1")
bos_color_bull    = input.color(color.new(#00E676, 0),  "BOS Bull",   group=grp_struct, inline="st2")
bos_color_bear    = input.color(color.new(#FF5252, 0),  "BOS Bear",   group=grp_struct, inline="st2")
choch_color_bull  = input.color(color.new(#00BCD4, 0),  "CHoCH Bull", group=grp_struct, inline="st3")
choch_color_bear  = input.color(color.new(#FF9800, 0),  "CHoCH Bear", group=grp_struct, inline="st3")

// --- Order Blocks ---
grp_ob = "═══ ⑤ ORDER BLOCKS ═══"
ob_bull_color       = input.color(color.new(#00E676, 75), "Bull OB",        group=grp_ob, inline="ob1")
ob_bear_color       = input.color(color.new(#FF5252, 75), "Bear OB",        group=grp_ob, inline="ob1")
ob_max_display      = input.int(10, "Max OBs",            minval=1, maxval=30,  group=grp_ob, inline="ob2")
ob_mitigation_pct   = input.float(50.0, "Mitigation %",   minval=10, maxval=100, step=5, group=grp_ob, inline="ob2")

// --- Supply / Demand ---
grp_sd = "═══ ③ SUPPLY / DEMAND ═══"
sd_impulse_mult      = input.float(1.5, "Impulse ATR Mult",  minval=0.5, maxval=5.0, step=0.1, group=grp_sd, inline="sd1")
sd_fresh_color_bull  = input.color(color.new(#00C853, 80),    "Fresh Demand",    group=grp_sd, inline="sd2")
sd_fresh_color_bear  = input.color(color.new(#D50000, 80),    "Fresh Supply",    group=grp_sd, inline="sd2")
sd_tested_color_bull = input.color(color.new(#00C853, 90),    "Tested Demand",   group=grp_sd, inline="sd3")
sd_tested_color_bear = input.color(color.new(#D50000, 90),    "Tested Supply",   group=grp_sd, inline="sd3")
sd_max_zones         = input.int(8, "Max Zones",             minval=1, maxval=20,  group=grp_sd, inline="sd4")

// --- FVG ---
grp_fvg = "═══ ⑦ FAIR VALUE GAPS ═══"
fvg_bull_color    = input.color(color.new(#2196F3, 80), "Bull FVG",       group=grp_fvg, inline="fvg1")
fvg_bear_color    = input.color(color.new(#E040FB, 80), "Bear FVG",       group=grp_fvg, inline="fvg1")
fvg_max_display   = input.int(10, "Max FVGs",           minval=1, maxval=30,  group=grp_fvg, inline="fvg2")
fvg_filter_atr    = input.bool(true, "Filter Small (ATR)", group=grp_fvg, inline="fvg2")
fvg_atr_mult      = input.float(0.1, "Min Size (ATR×)",    minval=0.01, maxval=1.0, step=0.01, group=grp_fvg, inline="fvg3")

// --- Liquidity ---
grp_liq = "═══ ⑥ LIQUIDITY ═══"
liq_lookback       = input.int(50, "Lookback Bars",       minval=10, maxval=200, group=grp_liq, inline="lq1")
liq_color          = input.color(color.new(#FFD600, 30),  "Level Color",        group=grp_liq, inline="lq1")
liq_eq_tolerance   = input.float(0.2, "Equal H/L ATR Tol", minval=0.01, maxval=1.0, step=0.05, group=grp_liq, inline="lq2")
liq_max_display    = input.int(15, "Max Levels",           minval=5, maxval=40,  group=grp_liq, inline="lq2")

// --- Diagonal Lines ---
grp_diag = "═══ ① DIAGONAL LINES ═══"
diag_bull_color    = input.color(color.new(#00E676, 30), "Bull Trendline",  group=grp_diag, inline="dg1")
diag_bear_color    = input.color(color.new(#FF5252, 30), "Bear Trendline",  group=grp_diag, inline="dg1")
diag_extend        = input.bool(true, "Extend Lines",      group=grp_diag, inline="dg2")
diag_break_signal  = input.bool(true, "Show Break Signals", group=grp_diag, inline="dg2")

// --- Confluence ---
grp_conf = "═══ ② CONFLUENCE ═══"
conf_min_factors     = input.int(2,    "Min Factors",         minval=2, maxval=5,    group=grp_conf, inline="cf1")
conf_zone_atr_mult   = input.float(1.0, "Zone Width (ATR×)",  minval=0.1, maxval=3.0, step=0.1, group=grp_conf, inline="cf1")
conf_strong_color    = input.color(color.new(#FFD600, 50),     "Confluence Color",    group=grp_conf, inline="cf2")

// --- Premium / Discount ---
grp_pd = "═══ ⑨ PREMIUM / DISCOUNT ═══"
pd_premium_color   = input.color(color.new(#FF5252, 92), "Premium BG",     group=grp_pd, inline="pd1")
pd_discount_color  = input.color(color.new(#00E676, 92), "Discount BG",    group=grp_pd, inline="pd1")
pd_show_bg         = input.bool(true, "Show Background",   group=grp_pd, inline="pd2")

// --- Market Phase ---
grp_phase = "═══ ⑩ MARKET PHASE ═══"
phase_lookback    = input.int(50, "Phase Lookback",    minval=20, maxval=200, group=grp_phase, inline="ph1")
phase_adr_period  = input.int(14, "ADR Period",        minval=5,  maxval=50,  group=grp_phase, inline="ph1")
phase_tbl_pos     = input.string("Top Right", "Table Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grp_phase, inline="ph2")

// --- Volume ---
grp_vol = "═══ ⑪ VOLUME CLIMAX ═══"
vol_sma_len       = input.int(20,    "Volume SMA Length",   minval=5, maxval=100,  group=grp_vol, inline="vl1")
vol_climax_mult   = input.float(2.0, "Climax Mult",         minval=1.0, maxval=5.0, step=0.1, group=grp_vol, inline="vl1")
vol_climax_color  = input.color(color.new(#FFD600, 0),       "Climax",              group=grp_vol, inline="vl2")
vol_exhaust_color = input.color(color.new(#E040FB, 0),       "Exhaustion",          group=grp_vol, inline="vl2")

// --- OTE ---
grp_ote = "═══ ⑦b OTE (OPTIMAL TRADE ENTRY) ═══"
ote_fib_start     = input.float(0.618, "OTE Fib Start",  minval=0.5, maxval=0.8, step=0.001, group=grp_ote, inline="ot1")
ote_fib_end       = input.float(0.786, "OTE Fib End",    minval=0.6, maxval=0.9, step=0.001, group=grp_ote, inline="ot1")
ote_bull_color    = input.color(color.new(#00BCD4, 80),   "Bull OTE",             group=grp_ote, inline="ot2")
ote_bear_color    = input.color(color.new(#FF9800, 80),   "Bear OTE",             group=grp_ote, inline="ot2")

// --- Dashboard ---
grp_dash = "═══ DASHBOARD ═══"
show_dashboard    = input.bool(true, "Show Dashboard",     group=grp_dash, inline="ds1")
dash_position     = input.string("Bottom Right", "Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=grp_dash, inline="ds1")

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░░░░░░ GLOBAL HELPERS ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

atr_val = ta.atr(14)

get_label_size(s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        => size.small

lbl_sz = get_label_size(struct_label_size)

// --- Drawing cleanup arrays (for barstate.islast redraws) ---
var array<line>  _lines  = array.new<line>()
var array<box>   _boxes  = array.new<box>()
var array<label> _labels = array.new<label>()

// --- request.security at global scope (v6 requirement) ---
prev_day_h = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
prev_day_l = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)

// --- ta.sma for ATR smoothing at global scope ---
atr_sma_20 = ta.sma(atr_val, 20)

// --- Day change detection at global scope ---
new_day_flag = ta.change(time("D")) != 0

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░░░░░░ SWING DETECTION ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

swing_hi = ta.pivothigh(high, swing_length, swing_length)
swing_lo = ta.pivotlow(low,   swing_length, swing_length)

var float last_sh       = na
var float last_sl       = na
var int   last_sh_bar   = na
var int   last_sl_bar   = na
var float prev_sh       = na
var float prev_sl       = na
var int   prev_sh_bar   = na
var int   prev_sl_bar   = na

// Third-level swings for multi-point trendlines
var float prev2_sh      = na
var float prev2_sl      = na
var int   prev2_sh_bar  = na
var int   prev2_sl_bar  = na

if not na(swing_hi)
    prev2_sh     := prev_sh
    prev2_sh_bar := prev_sh_bar
    prev_sh      := last_sh
    prev_sh_bar  := last_sh_bar
    last_sh      := swing_hi
    last_sh_bar  := bar_index - swing_length

if not na(swing_lo)
    prev2_sl     := prev_sl
    prev2_sl_bar := prev_sl_bar
    prev_sl      := last_sl
    prev_sl_bar  := last_sl_bar
    last_sl      := swing_lo
    last_sl_bar  := bar_index - swing_length

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 4: MARKET STRUCTURE (BOS & CHoCH) ░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

var int   trend_dir       = 0   // 1=bull, -1=bear
var float struct_high     = na
var float struct_low      = na
var int   struct_high_bar = na
var int   struct_low_bar  = na

bos_bull   = false
bos_bear   = false
choch_bull = false
choch_bear = false

if show_structure
    // Bullish break above last swing high
    if not na(last_sh) and close > last_sh and close[1] <= last_sh
        if trend_dir >= 0
            bos_bull := true
        else
            choch_bull := true
        trend_dir       := 1
        struct_high     := last_sh
        struct_high_bar := last_sh_bar

    // Bearish break below last swing low
    if not na(last_sl) and close < last_sl and close[1] >= last_sl
        if trend_dir <= 0
            bos_bear := true
        else
            choch_bear := true
        trend_dir      := -1
        struct_low     := last_sl
        struct_low_bar := last_sl_bar

// Draw BOS
if show_structure and bos_bull
    line.new(nz(last_sh_bar, bar_index), last_sh, bar_index, last_sh, color=bos_color_bull, style=line.style_dashed, width=1)
    label.new(math.round(math.avg(nz(last_sh_bar, bar_index), bar_index)), last_sh, "BOS", style=label.style_label_down, color=color.new(bos_color_bull, 80), textcolor=bos_color_bull, size=lbl_sz)

if show_structure and bos_bear
    line.new(nz(last_sl_bar, bar_index), last_sl, bar_index, last_sl, color=bos_color_bear, style=line.style_dashed, width=1)
    label.new(math.round(math.avg(nz(last_sl_bar, bar_index), bar_index)), last_sl, "BOS", style=label.style_label_up, color=color.new(bos_color_bear, 80), textcolor=bos_color_bear, size=lbl_sz)

// Draw CHoCH
if show_structure and choch_bull
    line.new(nz(last_sh_bar, bar_index), last_sh, bar_index, last_sh, color=choch_color_bull, style=line.style_dotted, width=2)
    label.new(math.round(math.avg(nz(last_sh_bar, bar_index), bar_index)), last_sh, "CHoCH", style=label.style_label_down, color=color.new(choch_color_bull, 80), textcolor=choch_color_bull, size=lbl_sz)

if show_structure and choch_bear
    line.new(nz(last_sl_bar, bar_index), last_sl, bar_index, last_sl, color=choch_color_bear, style=line.style_dotted, width=2)
    label.new(math.round(math.avg(nz(last_sl_bar, bar_index), bar_index)), last_sl, "CHoCH", style=label.style_label_up, color=color.new(choch_color_bear, 80), textcolor=choch_color_bear, size=lbl_sz)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 7a: FAIR VALUE GAPS (FVG) ░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

type FVGap
    float   top
    float   bottom
    int     start_bar
    bool    is_bull
    bool    is_filled

var array<FVGap> fvg_arr = array.new<FVGap>()

// Detect FVGs: 3-candle pattern where middle candle creates gap
bull_fvg_cond = low > high[2] and close[1] > open[1]
bear_fvg_cond = high < low[2] and close[1] < open[1]

// Track newest FVG direction for sweep+reversal module
var int   last_fvg_dir = 0
var int   last_fvg_bar = 0

if show_fvg or show_sweep_rev or show_confluence
    if bull_fvg_cond
        gap_sz = low - high[2]
        if not fvg_filter_atr or gap_sz > atr_val * fvg_atr_mult
            array.push(fvg_arr, FVGap.new(low, high[2], bar_index - 1, true, false))
            last_fvg_dir := 1
            last_fvg_bar := bar_index

    if bear_fvg_cond
        gap_sz = low[2] - high
        if not fvg_filter_atr or gap_sz > atr_val * fvg_atr_mult
            array.push(fvg_arr, FVGap.new(low[2], high, bar_index - 1, false, false))
            last_fvg_dir := -1
            last_fvg_bar := bar_index

    // Check fill status
    for i = array.size(fvg_arr) - 1 to 0
        if i >= array.size(fvg_arr)
            continue
        fvg = array.get(fvg_arr, i)
        if not fvg.is_filled
            if fvg.is_bull and low <= fvg.bottom
                fvg.is_filled := true
            if not fvg.is_bull and high >= fvg.top
                fvg.is_filled := true

    // Trim excess
    while array.size(fvg_arr) > fvg_max_display * 3
        array.shift(fvg_arr)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 5: ORDER BLOCKS ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

type OrderBlock
    float   top
    float   bottom
    int     start_bar
    bool    is_bull
    bool    is_mitigated
    int     touch_count

var array<OrderBlock> ob_arr = array.new<OrderBlock>()

// OB = last opposite candle before impulse creating BOS or FVG
ob_impulse_bull = (close - open) > atr_val and close > high[1]
ob_impulse_bear = (open - close) > atr_val and close < low[1]
ob_bull_trigger = ob_impulse_bull and (bos_bull or bull_fvg_cond)
ob_bear_trigger = ob_impulse_bear and (bos_bear or bear_fvg_cond)

// Fallback: strong impulse alone as OB source
ob_bull_fallback = close[1] < open[1] and ob_impulse_bull
ob_bear_fallback = close[1] > open[1] and ob_impulse_bear

if show_orderblocks or show_confluence
    if ob_bull_trigger or ob_bull_fallback
        array.push(ob_arr, OrderBlock.new(high[1], low[1], bar_index - 1, true, false, 0))

    if ob_bear_trigger or ob_bear_fallback
        array.push(ob_arr, OrderBlock.new(high[1], low[1], bar_index - 1, false, false, 0))

    // Mitigation check: 50% penetration
    for i = array.size(ob_arr) - 1 to 0
        if i >= array.size(ob_arr)
            continue
        ob = array.get(ob_arr, i)
        if not ob.is_mitigated
            ob_mid = ob.bottom + (ob.top - ob.bottom) * (ob_mitigation_pct / 100.0)
            if ob.is_bull and close < ob_mid
                ob.is_mitigated := true
            if not ob.is_bull and close > (ob.top - (ob.top - ob.bottom) * (ob_mitigation_pct / 100.0))
                ob.is_mitigated := true
            // Track touches (price enters zone but doesn't mitigate)
            if not ob.is_mitigated
                if ob.is_bull and low <= ob.top and low >= ob.bottom
                    ob.touch_count += 1
                if not ob.is_bull and high >= ob.bottom and high <= ob.top
                    ob.touch_count += 1

    // Trim
    while array.size(ob_arr) > ob_max_display * 3
        array.shift(ob_arr)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 3: SUPPLY / DEMAND ZONES ░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

type SDZone
    float   top
    float   bottom
    int     start_bar
    bool    is_demand
    int     status  // 0=fresh, 1=tested, 2=broken

var array<SDZone> sd_arr = array.new<SDZone>()

impulse_up   = (close - open) > atr_val * sd_impulse_mult and close > high[1]
impulse_down = (open - close) > atr_val * sd_impulse_mult and close < low[1]

if show_sd_zones or show_confluence
    if impulse_up
        zt = math.max(open[1], close[1])
        zb = math.min(open[1], close[1])
        if zt > zb
            array.push(sd_arr, SDZone.new(zt, zb, bar_index - 1, true, 0))

    if impulse_down
        zt = math.max(open[1], close[1])
        zb = math.min(open[1], close[1])
        if zt > zb
            array.push(sd_arr, SDZone.new(zt, zb, bar_index - 1, false, 0))

    // Status updates
    for i = array.size(sd_arr) - 1 to 0
        if i >= array.size(sd_arr)
            continue
        sd = array.get(sd_arr, i)
        if sd.status == 0
            if sd.is_demand and low <= sd.top and close > sd.bottom
                sd.status := 1
            if not sd.is_demand and high >= sd.bottom and close < sd.top
                sd.status := 1
        if sd.status <= 1
            if sd.is_demand and close < sd.bottom
                sd.status := 2
            if not sd.is_demand and close > sd.top
                sd.status := 2

    while array.size(sd_arr) > sd_max_zones * 3
        array.shift(sd_arr)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 6: LIQUIDITY & SWEEPS ░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

type LiqLevel
    float   price
    int     bar_idx
    bool    is_high
    bool    is_swept
    bool    is_equal   // Equal highs/lows flag
    string  lbl_text

var array<LiqLevel> liq_arr = array.new<LiqLevel>()

// Sweep tracking for Module 8
var bool sweep_bull_sig = false
var bool sweep_bear_sig = false
sweep_bull_sig := false
sweep_bear_sig := false

if show_liquidity or show_sweep_rev or show_confluence
    // Add swing highs/lows as liquidity
    if not na(swing_hi)
        array.push(liq_arr, LiqLevel.new(swing_hi, bar_index - swing_length, true, false, false, "$"))

    if not na(swing_lo)
        array.push(liq_arr, LiqLevel.new(swing_lo, bar_index - swing_length, false, false, false, "$"))

    // Detect Equal Highs / Equal Lows
    if not na(swing_hi) and not na(prev_sh) and math.abs(swing_hi - prev_sh) < atr_val * liq_eq_tolerance
        // Mark both as equal highs
        for i = array.size(liq_arr) - 1 to math.max(0, array.size(liq_arr) - 5)
            if i >= array.size(liq_arr) or i < 0
                continue
            lv = array.get(liq_arr, i)
            if lv.is_high and not lv.is_swept and math.abs(lv.price - swing_hi) < atr_val * liq_eq_tolerance
                lv.is_equal := true
                lv.lbl_text := "EQH $"

    if not na(swing_lo) and not na(prev_sl) and math.abs(swing_lo - prev_sl) < atr_val * liq_eq_tolerance
        for i = array.size(liq_arr) - 1 to math.max(0, array.size(liq_arr) - 5)
            if i >= array.size(liq_arr) or i < 0
                continue
            lv = array.get(liq_arr, i)
            if not lv.is_high and not lv.is_swept and math.abs(lv.price - swing_lo) < atr_val * liq_eq_tolerance
                lv.is_equal := true
                lv.lbl_text := "EQL $"

    // Previous day high/low as liquidity (using global-scope request.security)
    if new_day_flag and not na(prev_day_h)
        array.push(liq_arr, LiqLevel.new(prev_day_h, bar_index, true, false, false, "PDH $"))
        array.push(liq_arr, LiqLevel.new(prev_day_l, bar_index, false, false, false, "PDL $"))

    // Check sweeps (wick through level, close back inside)
    for i = array.size(liq_arr) - 1 to 0
        if i >= array.size(liq_arr)
            continue
        lv = array.get(liq_arr, i)
        if not lv.is_swept
            if lv.is_high and high > lv.price and close < lv.price
                lv.is_swept := true
                sweep_bear_sig := true
            if not lv.is_high and low < lv.price and close > lv.price
                lv.is_swept := true
                sweep_bull_sig := true

    // Trim to lookback limit
    while array.size(liq_arr) > liq_lookback
        array.shift(liq_arr)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 1: DIAGONAL TREND LINES ░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

var line  diag_bull_line       = na
var line  diag_bear_line       = na
var float diag_bull_slope      = na
var float diag_bear_slope      = na
var float diag_bull_start_p    = na
var float diag_bear_start_p    = na
var int   diag_bull_start_bar  = na
var int   diag_bear_start_bar  = na

if show_diagonal
    // Bullish trendline: two ascending swing lows
    if not na(swing_lo) and not na(prev_sl) and not na(last_sl_bar) and not na(prev_sl_bar)
        if last_sl > prev_sl and last_sl_bar > prev_sl_bar
            if not na(diag_bull_line)
                line.delete(diag_bull_line)
            ext = diag_extend ? extend.right : extend.none
            diag_bull_line      := line.new(prev_sl_bar, prev_sl, last_sl_bar, last_sl, color=diag_bull_color, width=2, extend=ext)
            diag_bull_slope     := (last_sl - prev_sl) / math.max(1, last_sl_bar - prev_sl_bar)
            diag_bull_start_p   := prev_sl
            diag_bull_start_bar := prev_sl_bar

    // Bearish trendline: two descending swing highs
    if not na(swing_hi) and not na(prev_sh) and not na(last_sh_bar) and not na(prev_sh_bar)
        if last_sh < prev_sh and last_sh_bar > prev_sh_bar
            if not na(diag_bear_line)
                line.delete(diag_bear_line)
            ext = diag_extend ? extend.right : extend.none
            diag_bear_line      := line.new(prev_sh_bar, prev_sh, last_sh_bar, last_sh, color=diag_bear_color, width=2, extend=ext)
            diag_bear_slope     := (last_sh - prev_sh) / math.max(1, last_sh_bar - prev_sh_bar)
            diag_bear_start_p   := prev_sh
            diag_bear_start_bar := prev_sh_bar

// Diagonal break detection
var bool diag_bull_break = false
var bool diag_bear_break = false
diag_bull_break := false
diag_bear_break := false

if show_diagonal and diag_break_signal
    // Break of bullish trendline (bearish)
    if not na(diag_bull_slope) and not na(diag_bull_start_bar) and not na(diag_bull_start_p)
        tl_now  = diag_bull_start_p + diag_bull_slope * (bar_index     - diag_bull_start_bar)
        tl_prev = diag_bull_start_p + diag_bull_slope * (bar_index - 1 - diag_bull_start_bar)
        if close < tl_now and close[1] >= tl_prev
            diag_bear_break := true
            label.new(bar_index, low, "TL Break", style=label.style_label_up, color=color.new(#FF5252, 50), textcolor=#FF5252, size=size.tiny)
            diag_bull_slope := na

    // Break of bearish trendline (bullish)
    if not na(diag_bear_slope) and not na(diag_bear_start_bar) and not na(diag_bear_start_p)
        tl_now  = diag_bear_start_p + diag_bear_slope * (bar_index     - diag_bear_start_bar)
        tl_prev = diag_bear_start_p + diag_bear_slope * (bar_index - 1 - diag_bear_start_bar)
        if close > tl_now and close[1] <= tl_prev
            diag_bull_break := true
            label.new(bar_index, high, "TL Break", style=label.style_label_down, color=color.new(#00E676, 50), textcolor=#00E676, size=size.tiny)
            diag_bear_slope := na

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░ MODULE 8: SWEEP + REVERSAL CONFIRMATION (TRIGGER) ░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// Trigger: Liquidity Sweep (6) + CHoCH (4) or opposite FVG (7) within same/next bar
sweep_rev_bull = false
sweep_rev_bear = false

if show_sweep_rev
    // Bullish: sweep below low + (CHoCH bull OR bullish FVG)
    bull_confirm = choch_bull or (last_fvg_dir == 1 and last_fvg_bar >= bar_index - 1)
    if sweep_bull_sig and bull_confirm
        sweep_rev_bull := true

    // Bearish: sweep above high + (CHoCH bear OR bearish FVG)
    bear_confirm = choch_bear or (last_fvg_dir == -1 and last_fvg_bar >= bar_index - 1)
    if sweep_bear_sig and bear_confirm
        sweep_rev_bear := true

if show_sweep_rev and sweep_rev_bull
    label.new(bar_index, low - atr_val * 0.3, "SWEEP+REV", style=label.style_label_up, color=color.new(#00E676, 10), textcolor=color.white, size=size.normal)

if show_sweep_rev and sweep_rev_bear
    label.new(bar_index, high + atr_val * 0.3, "SWEEP+REV", style=label.style_label_down, color=color.new(#FF5252, 10), textcolor=color.white, size=size.normal)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 9: PREMIUM / DISCOUNT ░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

var float pd_high = na
var float pd_low  = na

if show_premium_disc or show_ote or show_confluence
    if not na(last_sh)
        pd_high := last_sh
    if not na(last_sl)
        pd_low := last_sl

pd_mid         = na(pd_high) or na(pd_low) ? na : (pd_high + pd_low) / 2.0
pd_is_premium  = not na(pd_mid) and close > pd_mid
pd_is_discount = not na(pd_mid) and close <= pd_mid

// Background coloring (user toggle)
bgcolor(show_premium_disc and pd_show_bg and pd_is_premium  ? pd_premium_color  : na, title="Premium BG")
bgcolor(show_premium_disc and pd_show_bg and pd_is_discount ? pd_discount_color : na, title="Discount BG")

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 11: VOLUME CLIMAX & EXHAUSTION ░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

vol_sma_val    = ta.sma(volume, vol_sma_len)
vol_is_climax  = volume > vol_sma_val * vol_climax_mult

body_sz    = math.abs(close - open)
total_rng  = high - low
small_body = total_rng > 0 ? body_sz / total_rng < 0.3 : false
vol_is_exhaust = volume > vol_sma_val * vol_climax_mult * 1.25 and small_body

// Volume divergence
vol_div_bear = not na(swing_hi) and not na(prev_sh) and swing_hi > prev_sh and volume < vol_sma_val * 0.8
vol_div_bull = not na(swing_lo) and not na(prev_sl) and swing_lo < prev_sl and volume < vol_sma_val * 0.8

if show_volume_climax
    if vol_is_exhaust
        label.new(bar_index, high + atr_val * 0.1, "X", style=label.style_label_down, color=color.new(vol_exhaust_color, 30), textcolor=vol_exhaust_color, size=size.tiny, tooltip="Volume Exhaustion")
    else if vol_is_climax
        label.new(bar_index, low - atr_val * 0.1, "V!", style=label.style_label_up, color=color.new(vol_climax_color, 50), textcolor=vol_climax_color, size=size.tiny, tooltip="Volume Climax")

    if vol_div_bear
        label.new(bar_index - swing_length, swing_hi, "VD", style=label.style_label_down, color=color.new(#E040FB, 60), textcolor=#E040FB, size=size.tiny, tooltip="Bearish Volume Divergence")

    if vol_div_bull
        label.new(bar_index - swing_length, swing_lo, "VD", style=label.style_label_up, color=color.new(#00BCD4, 60), textcolor=#00BCD4, size=size.tiny, tooltip="Bullish Volume Divergence")

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 10: MARKET PHASE DETECTOR ░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

highest_h  = ta.highest(high, phase_lookback)
lowest_l   = ta.lowest(low,   phase_lookback)
range_sz   = highest_h - lowest_l
adr_val    = ta.atr(phase_adr_period)

is_ranging     = range_sz < adr_val * 5
ema_fast       = ta.ema(close, 9)
ema_slow       = ta.ema(close, 21)
is_trend_up    = ema_fast > ema_slow and close > ema_slow
is_trend_down  = ema_fast < ema_slow and close < ema_slow

vol_sma_phase  = ta.sma(volume, phase_lookback)
vol_inc        = volume > vol_sma_phase * 1.3
vol_dec        = volume < vol_sma_phase * 0.7

var string market_phase = "Consolidation"

if show_market_phase
    if is_ranging and vol_dec
        market_phase := "Accumulation"
    else if is_ranging and vol_inc
        market_phase := "Distribution"
    else if not is_ranging and (is_trend_up or is_trend_down) and vol_inc
        market_phase := "Expansion"
    else if is_trend_up
        market_phase := "Trending Up"
    else if is_trend_down
        market_phase := "Trending Down"
    else if is_ranging
        market_phase := "Consolidation"
    else
        market_phase := "Transition"

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MODULE 2: CONFLUENCE ENGINE ░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

conf_score = 0
conf_range = nz(atr_val) * conf_zone_atr_mult

if show_confluence
    // Factor 1: Near active Order Block
    if array.size(ob_arr) > 0
        for i = math.max(0, array.size(ob_arr) - 10) to array.size(ob_arr) - 1
            if i >= array.size(ob_arr)
                break
            ob = array.get(ob_arr, i)
            if not ob.is_mitigated
                if close >= ob.bottom - conf_range and close <= ob.top + conf_range
                    conf_score += 1
                    break  // count once

    // Factor 2: Near active S/D Zone
    if array.size(sd_arr) > 0
        for i = math.max(0, array.size(sd_arr) - 10) to array.size(sd_arr) - 1
            if i >= array.size(sd_arr)
                break
            sd = array.get(sd_arr, i)
            if sd.status < 2
                if close >= sd.bottom - conf_range and close <= sd.top + conf_range
                    conf_score += 1
                    break

    // Factor 3: Near unfilled FVG
    if array.size(fvg_arr) > 0
        for i = math.max(0, array.size(fvg_arr) - 10) to array.size(fvg_arr) - 1
            if i >= array.size(fvg_arr)
                break
            fvg = array.get(fvg_arr, i)
            if not fvg.is_filled
                if close >= fvg.bottom - conf_range and close <= fvg.top + conf_range
                    conf_score += 1
                    break

    // Factor 4: Near liquidity level
    if array.size(liq_arr) > 0
        for i = math.max(0, array.size(liq_arr) - 10) to array.size(liq_arr) - 1
            if i >= array.size(liq_arr)
                break
            lv = array.get(liq_arr, i)
            if not lv.is_swept
                if math.abs(close - lv.price) <= conf_range
                    conf_score += 1
                    break

    // Factor 5: Near diagonal trendline
    if not na(diag_bull_slope) and not na(diag_bull_start_bar) and not na(diag_bull_start_p)
        tl_p = diag_bull_start_p + diag_bull_slope * (bar_index - diag_bull_start_bar)
        if math.abs(close - tl_p) <= conf_range
            conf_score += 1

    if not na(diag_bear_slope) and not na(diag_bear_start_bar) and not na(diag_bear_start_p)
        tl_p = diag_bear_start_p + diag_bear_slope * (bar_index - diag_bear_start_bar)
        if math.abs(close - tl_p) <= conf_range
            conf_score += 1

    // Factor 6: Premium/Discount alignment with trend
    if pd_is_discount and trend_dir == 1
        conf_score += 1
    if pd_is_premium and trend_dir == -1
        conf_score += 1

    // Factor 7: In OTE zone
    if show_ote and not na(pd_high) and not na(pd_low) and pd_high > pd_low
        r = pd_high - pd_low
        fib_pos = (close - pd_low) / r
        if trend_dir == 1 and fib_pos >= (1.0 - ote_fib_end) and fib_pos <= (1.0 - ote_fib_start)
            conf_score += 1
        if trend_dir == -1 and fib_pos >= ote_fib_start and fib_pos <= ote_fib_end
            conf_score += 1

// Confluence highlight (background)
conf_bg_col = conf_score >= 5 ? color.new(conf_strong_color, 70) : conf_score >= 3 ? color.new(conf_strong_color, 82) : conf_score >= conf_min_factors ? color.new(#9E9E9E, 88) : na
bgcolor(show_confluence and conf_score >= conf_min_factors ? conf_bg_col : na, title="Confluence Zone")

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ BARSTATE.ISLAST — DRAW ALL ZONES ░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

if barstate.islast
    // Cleanup previous barstate.islast drawings
    for _i = 0 to array.size(_lines) - 1
        if _i < array.size(_lines)
            line.delete(array.get(_lines, _i))
    array.clear(_lines)
    for _i = 0 to array.size(_boxes) - 1
        if _i < array.size(_boxes)
            box.delete(array.get(_boxes, _i))
    array.clear(_boxes)
    for _i = 0 to array.size(_labels) - 1
        if _i < array.size(_labels)
            label.delete(array.get(_labels, _i))
    array.clear(_labels)

    // ──── Draw Order Blocks ────
    if show_orderblocks
        drawn_ob = 0
        for i = array.size(ob_arr) - 1 to 0
            if drawn_ob >= ob_max_display or i < 0 or i >= array.size(ob_arr)
                break
            ob = array.get(ob_arr, i)
            if not ob.is_mitigated
                ob_col = ob.is_bull ? ob_bull_color : ob_bear_color
                array.push(_boxes, box.new(ob.start_bar, ob.top, bar_index + 5, ob.bottom, border_color=ob_col, bgcolor=ob_col, border_width=1))
                txt = (ob.is_bull ? "Bull OB" : "Bear OB") + (ob.touch_count > 0 ? " (" + str.tostring(ob.touch_count) + "x)" : "")
                array.push(_labels, label.new(ob.start_bar, ob.is_bull ? ob.bottom : ob.top, txt, style=ob.is_bull ? label.style_label_up : label.style_label_down, color=color.new(color.black, 100), textcolor=ob.is_bull ? color.green : color.red, size=size.tiny))
                drawn_ob += 1

    // ──── Draw Supply / Demand Zones ────
    if show_sd_zones
        drawn_sd = 0
        for i = array.size(sd_arr) - 1 to 0
            if drawn_sd >= sd_max_zones or i < 0 or i >= array.size(sd_arr)
                break
            sd = array.get(sd_arr, i)
            if sd.status < 2
                sd_col = sd.is_demand ? (sd.status == 0 ? sd_fresh_color_bull : sd_tested_color_bull) : (sd.status == 0 ? sd_fresh_color_bear : sd_tested_color_bear)
                bdr_style = sd.status == 0 ? line.style_solid : line.style_dashed
                array.push(_boxes, box.new(sd.start_bar, sd.top, bar_index + 5, sd.bottom, border_color=sd_col, bgcolor=sd_col, border_width=1, border_style=bdr_style))
                stxt = (sd.is_demand ? "Demand" : "Supply") + " (" + (sd.status == 0 ? "Fresh" : "Tested") + ")"
                array.push(_labels, label.new(sd.start_bar, sd.is_demand ? sd.bottom : sd.top, stxt, style=sd.is_demand ? label.style_label_up : label.style_label_down, color=color.new(color.black, 100), textcolor=sd.is_demand ? color.green : color.red, size=size.tiny))
                drawn_sd += 1

    // ──── Draw FVGs ────
    if show_fvg
        drawn_fvg = 0
        for i = array.size(fvg_arr) - 1 to 0
            if drawn_fvg >= fvg_max_display or i < 0 or i >= array.size(fvg_arr)
                break
            fvg = array.get(fvg_arr, i)
            if not fvg.is_filled
                fvg_col = fvg.is_bull ? fvg_bull_color : fvg_bear_color
                array.push(_boxes, box.new(fvg.start_bar, fvg.top, bar_index + 3, fvg.bottom, border_color=fvg_col, bgcolor=fvg_col, border_width=1))
                array.push(_labels, label.new(fvg.start_bar, fvg.is_bull ? fvg.bottom : fvg.top, "FVG", style=fvg.is_bull ? label.style_label_up : label.style_label_down, color=color.new(color.black, 100), textcolor=fvg.is_bull ? color.blue : color.purple, size=size.tiny))
                drawn_fvg += 1

    // ──── Draw Liquidity Levels ────
    if show_liquidity
        drawn_liq = 0
        for i = array.size(liq_arr) - 1 to 0
            if drawn_liq >= liq_max_display or i < 0 or i >= array.size(liq_arr)
                break
            lv = array.get(liq_arr, i)
            if not lv.is_swept
                lc = lv.is_equal ? color.new(#FF6D00, 20) : liq_color
                array.push(_lines, line.new(lv.bar_idx, lv.price, bar_index + 5, lv.price, color=lc, style=line.style_dotted, width=lv.is_equal ? 2 : 1))
                array.push(_labels, label.new(bar_index + 5, lv.price, lv.lbl_text, style=label.style_label_left, color=color.new(color.black, 100), textcolor=lv.is_equal ? #FF6D00 : #FFD600, size=size.tiny))
                drawn_liq += 1

    // ──── Draw Premium / Discount ────
    if show_premium_disc and not na(pd_mid)
        array.push(_lines, line.new(bar_index - 50, pd_mid, bar_index + 5, pd_mid, color=color.new(#9E9E9E, 60), style=line.style_dashed, width=1))
        array.push(_labels, label.new(bar_index + 6, pd_mid, "EQ 50%", style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.gray, size=size.tiny))

        if not na(pd_high) and not na(pd_low) and pd_high > pd_low
            fib_lvl = (close - pd_low) / (pd_high - pd_low)
            z_txt = fib_lvl > 0.5 ? "PREMIUM (" + str.tostring(fib_lvl * 100, "#.0") + "%)" : "DISCOUNT (" + str.tostring(fib_lvl * 100, "#.0") + "%)"
            z_col = fib_lvl > 0.5 ? color.red : color.green
            array.push(_labels, label.new(bar_index + 8, close, z_txt, style=label.style_label_left, color=color.new(color.black, 100), textcolor=z_col, size=size.small))

    // ──── Draw OTE Zones ────
    if show_ote and not na(pd_high) and not na(pd_low) and pd_high > pd_low
        r_sz = pd_high - pd_low
        if trend_dir == 1
            ote_t = pd_high - r_sz * ote_fib_start
            ote_b = pd_high - r_sz * ote_fib_end
            array.push(_boxes, box.new(bar_index - 30, ote_t, bar_index + 5, ote_b, border_color=ote_bull_color, bgcolor=ote_bull_color, border_width=1, border_style=line.style_dashed))
            array.push(_labels, label.new(bar_index + 5, (ote_t + ote_b) / 2, "OTE Buy\n" + str.tostring(ote_fib_start, "#.###") + "-" + str.tostring(ote_fib_end, "#.###"), style=label.style_label_left, color=color.new(color.black, 100), textcolor=#00BCD4, size=size.tiny))
        if trend_dir == -1
            ote_t = pd_low + r_sz * ote_fib_end
            ote_b = pd_low + r_sz * ote_fib_start
            array.push(_boxes, box.new(bar_index - 30, ote_t, bar_index + 5, ote_b, border_color=ote_bear_color, bgcolor=ote_bear_color, border_width=1, border_style=line.style_dashed))
            array.push(_labels, label.new(bar_index + 5, (ote_t + ote_b) / 2, "OTE Sell\n" + str.tostring(ote_fib_start, "#.###") + "-" + str.tostring(ote_fib_end, "#.###"), style=label.style_label_left, color=color.new(color.black, 100), textcolor=#FF9800, size=size.tiny))

    // ──── Draw Confluence Label ────
    if show_confluence and conf_score >= conf_min_factors
        c_txt = "CONFLUENCE: " + str.tostring(conf_score) + " factors"
        c_col = conf_score >= 5 ? #FFD600 : conf_score >= 3 ? #FF9800 : #9E9E9E
        array.push(_labels, label.new(bar_index, high + atr_val * 0.5, c_txt, style=label.style_label_down, color=color.new(c_col, 20), textcolor=color.white, size=size.small))

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ MARKET PHASE TABLE ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

var table phase_tbl = na

if show_market_phase
    phase_pos = switch phase_tbl_pos
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.top_right

    if na(phase_tbl)
        phase_tbl := table.new(phase_pos, 2, 5, bgcolor=color.new(#1E1E1E, 10), border_width=1, border_color=color.new(color.gray, 50))

    phase_col = switch market_phase
        "Accumulation"  => color.new(#00BCD4, 0)
        "Distribution"  => color.new(#FF9800, 0)
        "Expansion"     => color.new(#E040FB, 0)
        "Trending Up"   => color.new(#00E676, 0)
        "Trending Down" => color.new(#FF5252, 0)
        "Consolidation" => color.new(#9E9E9E, 0)
        => color.new(#FFD600, 0)

    table.cell(phase_tbl, 0, 0, "PHASE",     text_color=color.white, text_size=size.tiny)
    table.cell(phase_tbl, 1, 0, market_phase, text_color=phase_col,  text_size=size.tiny)

    trend_txt = trend_dir == 1 ? "BULLISH" : trend_dir == -1 ? "BEARISH" : "NEUTRAL"
    trend_col = trend_dir == 1 ? color.green : trend_dir == -1 ? color.red : color.gray
    table.cell(phase_tbl, 0, 1, "TREND",     text_color=color.white, text_size=size.tiny)
    table.cell(phase_tbl, 1, 1, trend_txt,    text_color=trend_col,  text_size=size.tiny)

    zone_txt = pd_is_premium ? "PREMIUM" : pd_is_discount ? "DISCOUNT" : "EQ"
    zone_col = pd_is_premium ? color.red : pd_is_discount ? color.green : color.gray
    table.cell(phase_tbl, 0, 2, "ZONE",      text_color=color.white, text_size=size.tiny)
    table.cell(phase_tbl, 1, 2, zone_txt,     text_color=zone_col,   text_size=size.tiny)

    vol_state = atr_val > atr_sma_20 * 1.2 ? "HIGH" : atr_val < atr_sma_20 * 0.8 ? "LOW" : "NORMAL"
    vol_s_col = vol_state == "HIGH" ? color.orange : vol_state == "LOW" ? color.aqua : color.gray
    table.cell(phase_tbl, 0, 3, "VOLATILITY", text_color=color.white, text_size=size.tiny)
    table.cell(phase_tbl, 1, 3, vol_state,     text_color=vol_s_col,  text_size=size.tiny)

    conf_dash = conf_score >= 5 ? "STRONG" : conf_score >= 3 ? "MODERATE" : conf_score >= 2 ? "WEAK" : "NONE"
    conf_d_col = conf_score >= 5 ? #FFD600 : conf_score >= 3 ? #FF9800 : color.gray
    table.cell(phase_tbl, 0, 4, "CONFLUENCE", text_color=color.white, text_size=size.tiny)
    table.cell(phase_tbl, 1, 4, conf_dash + " (" + str.tostring(conf_score) + ")", text_color=conf_d_col, text_size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ DASHBOARD TABLE ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

var table dash_tbl = na

if show_dashboard
    d_pos = switch dash_position
        "Top Right"    => position.top_right
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        => position.bottom_right

    // Avoid overlap with phase table
    actual_pos = show_market_phase and dash_position == phase_tbl_pos ? position.bottom_left : d_pos

    if na(dash_tbl)
        dash_tbl := table.new(actual_pos, 2, 8, bgcolor=color.new(#1E1E1E, 10), border_width=1, border_color=color.new(color.gray, 50))

    table.cell(dash_tbl, 0, 0, "SMC SCANNER", text_color=#FFD600, text_size=size.small)
    table.cell(dash_tbl, 1, 0, "v6.0",        text_color=color.gray, text_size=size.tiny)

    // Active OBs
    active_obs = 0
    for i = 0 to array.size(ob_arr) - 1
        if i < array.size(ob_arr)
            ob = array.get(ob_arr, i)
            if not ob.is_mitigated
                active_obs += 1
    table.cell(dash_tbl, 0, 1, "Order Blocks", text_color=color.white, text_size=size.tiny)
    table.cell(dash_tbl, 1, 1, str.tostring(active_obs) + " active", text_color=active_obs > 0 ? color.green : color.gray, text_size=size.tiny)

    // Active S/D
    active_sd = 0
    for i = 0 to array.size(sd_arr) - 1
        if i < array.size(sd_arr)
            sd = array.get(sd_arr, i)
            if sd.status < 2
                active_sd += 1
    table.cell(dash_tbl, 0, 2, "S/D Zones", text_color=color.white, text_size=size.tiny)
    table.cell(dash_tbl, 1, 2, str.tostring(active_sd) + " active", text_color=active_sd > 0 ? color.green : color.gray, text_size=size.tiny)

    // Active FVGs
    active_fvg = 0
    for i = 0 to array.size(fvg_arr) - 1
        if i < array.size(fvg_arr)
            fvg = array.get(fvg_arr, i)
            if not fvg.is_filled
                active_fvg += 1
    table.cell(dash_tbl, 0, 3, "FVGs", text_color=color.white, text_size=size.tiny)
    table.cell(dash_tbl, 1, 3, str.tostring(active_fvg) + " open", text_color=active_fvg > 0 ? color.blue : color.gray, text_size=size.tiny)

    // Liquidity
    active_liq = 0
    for i = 0 to array.size(liq_arr) - 1
        if i < array.size(liq_arr)
            lv = array.get(liq_arr, i)
            if not lv.is_swept
                active_liq += 1
    table.cell(dash_tbl, 0, 4, "Liquidity", text_color=color.white, text_size=size.tiny)
    table.cell(dash_tbl, 1, 4, str.tostring(active_liq) + " levels", text_color=active_liq > 0 ? #FFD600 : color.gray, text_size=size.tiny)

    // ATR
    table.cell(dash_tbl, 0, 5, "ATR(14)", text_color=color.white, text_size=size.tiny)
    table.cell(dash_tbl, 1, 5, str.tostring(atr_val, "#.#####"), text_color=color.gray, text_size=size.tiny)

    // Volume
    v_status = vol_is_exhaust ? "EXHAUSTION" : vol_is_climax ? "CLIMAX" : volume > vol_sma_val ? "ABOVE AVG" : "BELOW AVG"
    v_col = vol_is_exhaust ? #E040FB : vol_is_climax ? #FFD600 : volume > vol_sma_val ? color.green : color.gray
    table.cell(dash_tbl, 0, 6, "Volume", text_color=color.white, text_size=size.tiny)
    table.cell(dash_tbl, 1, 6, v_status, text_color=v_col, text_size=size.tiny)

    // Sweep + Reversal status
    sr_txt = sweep_rev_bull ? "BULL TRIGGER" : sweep_rev_bear ? "BEAR TRIGGER" : sweep_bull_sig ? "BULL SWEEP" : sweep_bear_sig ? "BEAR SWEEP" : "—"
    sr_col = sweep_rev_bull ? color.lime : sweep_rev_bear ? color.red : sweep_bull_sig or sweep_bear_sig ? color.orange : color.gray
    table.cell(dash_tbl, 0, 7, "Sweep/Rev", text_color=color.white, text_size=size.tiny)
    table.cell(dash_tbl, 1, 7, sr_txt, text_color=sr_col, text_size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░ ALERTS (global scope — v6 requirement) ░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════

// Structure
alertcondition(bos_bull,       "BOS Bullish",         "Bullish Break of Structure")
alertcondition(bos_bear,       "BOS Bearish",         "Bearish Break of Structure")
alertcondition(choch_bull,     "CHoCH Bullish",       "Bullish Change of Character")
alertcondition(choch_bear,     "CHoCH Bearish",       "Bearish Change of Character")

// Liquidity sweep
alertcondition(sweep_bull_sig, "Bullish Liq Sweep",   "Liquidity swept below swing low")
alertcondition(sweep_bear_sig, "Bearish Liq Sweep",   "Liquidity swept above swing high")

// Sweep + Reversal trigger
alertcondition(sweep_rev_bull, "Sweep+Rev Bullish",   "Bullish sweep + CHoCH/FVG reversal confirmed")
alertcondition(sweep_rev_bear, "Sweep+Rev Bearish",   "Bearish sweep + CHoCH/FVG reversal confirmed")

// Diagonal break
alertcondition(diag_bull_break, "Trendline Break Bull", "Bearish trendline broken — bullish")
alertcondition(diag_bear_break, "Trendline Break Bear", "Bullish trendline broken — bearish")

// Volume
alertcondition(vol_is_climax,  "Volume Climax",       "Volume climax detected")
alertcondition(vol_is_exhaust, "Volume Exhaustion",    "Volume exhaustion — high volume + small body")
alertcondition(vol_div_bear,   "Vol Divergence Bear",  "Bearish volume divergence at swing high")
alertcondition(vol_div_bull,   "Vol Divergence Bull",  "Bullish volume divergence at swing low")

// Confluence
alertcondition(conf_score >= conf_min_factors, "Confluence Zone", "Price in high-probability confluence zone")

// ══════════════════════════════════════════════════════════════════════════════
// ░░░░░░░░░░░░░░░░░░░░░░░░░░ END ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
// ══════════════════════════════════════════════════════════════════════════════
